# ─────────────────────────────────────────────────────────────────────────────
# Remirdy Blender Studio MCP — Environment Variables
# Copy this file to .env and fill in the values you need.
# Only the variables relevant to your workflow are required.
# ─────────────────────────────────────────────────────────────────────────────

# ── Bridge (Blender ↔ MCP server connection) ──────────────────────────────────
# TCP port the Blender add-on bridge listens on (default 8765)
# REMIRDY_BRIDGE_PORT=8765

# Seconds to wait for Blender to respond before timing out (default 3900)
# REMIRDY_BRIDGE_TIMEOUT=3900

# Optional shared secret token for bridge authentication
# REMIRDY_BRIDGE_TOKEN=

# ── General server settings ───────────────────────────────────────────────────
# Working directory for generated files (default: ~/RemirdyWorkspace)
# REMIRDY_WORKSPACE=~/RemirdyWorkspace

# Log verbosity: DEBUG | INFO | WARNING | ERROR (default: INFO)
# REMIRDY_LOG_LEVEL=INFO

# Opt out of anonymous usage telemetry: 0 | 1 (default: 1 = enabled)
# REMIRDY_TELEMETRY=1

# ── Cloud image-to-3D providers ───────────────────────────────────────────────
# Meshy.ai  — https://app.meshy.ai/
# MESHY_API_KEY=your_meshy_api_key_here
# REMIRDY_MESHY_API_KEY=   # Alternative name (either works)
# REMIRDY_MESHY_MODEL=latest   # Meshy model version override

# Tripo.ai  — https://platform.tripo3d.ai/
# TRIPO_API_KEY=your_tripo_api_key_here
# REMIRDY_TRIPO_API_KEY=   # Alternative name

# Rodin (Hyper3D) — https://hyper3d.ai/
# RODIN_API_KEY=your_rodin_api_key_here
# REMIRDY_RODIN_API_KEY=   # Alternative name

# Hunyuan3D (Tencent) — https://3d.hunyuan.tencent.com/
# HUNYUAN3D_API_KEY=your_hunyuan3d_api_key_here
# HUNYUAN3D_ENDPOINT=https://hunyuan.tencentcloudapi.com

# ── Local image-to-3D (TripoSR / custom command) ─────────────────────────────
# Shell command that converts an image to a GLB file.
# Placeholders: {input_image} and {output_glb}
# Example using TripoSR:
# REMIRDY_LOCAL_IMAGE_TO_3D_COMMAND=python ~/ai_models/TripoSR/run.py {input_image} --output-dir {output_glb}
# REMIRDY_IMAGE_TO_3D_COMMAND=   # Legacy alias

# Provider selector: local | meshy | tripo | rodin | hunyuan3d | auto | parallel
# REMIRDY_IMAGE_TO_3D_PROVIDER=auto

# Seconds to wait for local image-to-3D generation (default: 3600)
# REMIRDY_IMAGE_TO_3D_WAIT_SECONDS=3600

# Additional bridge request timeout for long-running Blender ops (default: 3900)
# REMIRDY_BRIDGE_REQUEST_TIMEOUT=3900

# Target polygon count hint for generated 3D models (default: 100000)
# REMIRDY_TARGET_POLYCOUNT=100000

# Target height (metres) applied when auto-normalising imported meshes (default: 1.8)
# REMIRDY_IMPORTED_TARGET_HEIGHT=1.8

# ── AI Vision (Gemini) ────────────────────────────────────────────────────────
# Google Gemini Vision API key — https://aistudio.google.com/
# Used by the PSD/image → 3D scene analyser (gemini-2.5-flash).
# When unset the system falls back to the built-in colour-sampling analyser.
# GEMINI_API_KEY=your_gemini_api_key_here
# GOOGLE_GEMINI_API_KEY=   # Alternative name (either works)
